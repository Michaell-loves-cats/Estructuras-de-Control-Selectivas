 */
let tipo = prompt("Tipo de panela (P1 o P2):");
let tamaño = Number(prompt("Tamaño de la panela (1 o 2):"));
let precio = Number(prompt("Precio base por kilo:"));
let kilos = Number(prompt("Kilos de producción:"));

let ajuste = 0;

if (tipo === "P1") {
    if (tamaño === 1) {
        ajuste = 1200;
    } else {
        ajuste = 830;
    }
}

else if (tipo === "P2") {
    if (tamaño === 1) {
        ajuste = -540;
    } else {
        ajuste = -350;
    }
} else {
    alert("Tipo inválido");
}

let precioFinal = precio + ajuste;
let ganancia = precioFinal * kilos;

alert("La ganancia es: $ " + ganancia);



